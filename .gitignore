# Binaries for programs and plugins
*.exe
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Project-local glide cache, RE: https://github.com/Masterminds/glide/issues/736
.glide/

# Compiled binary, anchored to avoid matching the cmd/go-udev directory
/go-udev
/cmd/go-udev/go-udev
*.log
*.swp

# Local environment files, they must never be committed since they usually hold credentials
.env
.envrc
*.envrc
